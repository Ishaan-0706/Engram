{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.dev/contracts/synthesis-answer.schema.json",
  "title": "Structured synthesis output",
  "description": "Every claim must cite at least one evidence_bag key. Missing or unknown ids raise UnverifiableClaimException.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "cited_evidence_ids"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "cited_evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "mcp-tool-response.schema.json#/$defs/evidenceId"
            }
          }
        }
      }
    }
  }
}
