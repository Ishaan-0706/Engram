{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.dev/shared/contracts/mcp_envelope.schema.json",
  "title": "MCP tool response envelope",
  "description": "Developer 1 graph tools emit this shape. Cite only evidence[].id.",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "properties"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "properties": { "type": "object" },
        "adjacent": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_id",
        "excerpt",
        "source_uri",
        "source_timestamp",
        "content_hash"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "record_id": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "source_timestamp": { "$ref": "#/$defs/rfc3339" },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_type": { "type": "string" },
        "author": { "type": "string" }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "tenant_id", "trace_id", "as_of", "records", "evidence"],
      "properties": {
        "ok": { "const": true },
        "tenant_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "as_of": { "$ref": "#/$defs/rfc3339" },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/record" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
