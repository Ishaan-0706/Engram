# =============================================================================
# Company Brain – Centralized Environment Configuration
# =============================================================================

# FalkorDB Graph Database
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Redis Turn State & Distributed Locks
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# Agent State Machine & Lock Lifetimes (in seconds)
TURN_TTL_SECONDS=7200
PROPOSAL_LOCK_TTL_SECONDS=30

# Graph Query Timeout (in milliseconds)
GRAPH_QUERY_TIMEOUT_MS=2500

# LLM Grounded Synthesis Configuration
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
